generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String
  name           String?
  role           Role     @default(ADMIN)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum Role {
  ADMIN
  SUPERADMIN
}

enum SeasonalOfferType {
  OBOZ
  POLKOLONIA
}

model Group {
  id              String   @id @default(cuid())
  name            String   @unique
  number          String
  ageRange        String
  colorPreset     String
  sortOrder       Int      @default(0)
  lessonDuration  Int      @default(45)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  slots  TrainingSlot[]
  prices GroupPrice[]
}

model TrainingSlot {
  id      String @id @default(cuid())
  groupId String
  day     Int
  hour    String
  track   Int    @default(1)
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, day, hour])
}

model GroupPrice {
  id        String @id @default(cuid())
  groupId   String
  frequency Int
  price     Int
  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, frequency])
}

model SemesterDayCount {
  id    String @id @default("default")
  label String @default("")
  mon   Int    @default(0)
  tue   Int    @default(0)
  wed   Int    @default(0)
  thu   Int    @default(0)
  fri   Int    @default(0)
  sun   Int    @default(0)
}

model News {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  content     String
  images      String[]
  published   Boolean  @default(false)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Coach {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String
  imageUrl  String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Achievement {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  content     String
  images      String[]
  published   Boolean  @default(false)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SeasonalOffer {
  id              String            @id @default(cuid())
  type            SeasonalOfferType
  title           String
  slug            String            @unique
  summary         String
  locationName    String
  locationAddress String?
  startDate       DateTime?
  endDate         DateTime?
  ageRange        String?
  price           String?
  priceNote       String?
  accommodation   String?
  meals           String?
  transport       String?
  program         String
  included        String?
  signupInfo      String?
  images          String[]
  published       Boolean           @default(false)
  featured        Boolean           @default(false)
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([type, published, sortOrder])
}
